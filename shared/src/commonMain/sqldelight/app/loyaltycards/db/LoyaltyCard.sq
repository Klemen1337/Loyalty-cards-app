CREATE TABLE loyalty_card (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    -- Key into app.loyaltycards.domain.StoreCatalog, null for stores the app doesn't know.
    store_id TEXT,
    name TEXT NOT NULL,
    card_number TEXT NOT NULL,
    -- Barcode symbology name, see app.loyaltycards.domain.BarcodeFormat.
    barcode_format TEXT NOT NULL,
    -- Card color as ARGB.
    color INTEGER NOT NULL,
    name_on_card TEXT,
    -- Sort order in the wallet, ascending.
    position INTEGER NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE INDEX loyalty_card_position ON loyalty_card(position);

