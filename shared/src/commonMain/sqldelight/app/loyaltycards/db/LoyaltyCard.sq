selectAll:
SELECT *
FROM loyalty_card
ORDER BY position ASC, id ASC;

nextPosition:
SELECT COALESCE(MAX(position) + 1, 0) AS next
FROM loyalty_card;

insert:
INSERT INTO loyalty_card (store_id, name, card_number, barcode_format, color, name_on_card, position, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

lastInsertedId:
SELECT last_insert_rowid();

updatePosition:
UPDATE loyalty_card
SET position = :position
WHERE id = :id;

deleteById:
DELETE FROM loyalty_card
WHERE id = :id;
